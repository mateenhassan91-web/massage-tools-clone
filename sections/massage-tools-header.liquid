{{ 'header-mt.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign top_menu = section.settings.main_menu
  assign phone = section.settings.phone_number
  assign phone_tel = phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign text_number = section.settings.text_number
-%}

<header class="mt-header" data-header>

  {%- comment -%} ===== UTILITY BAR ===== {%- endcomment -%}
  <div class="mt-utility-bar" style="background:{{ section.settings.utility_bg }};color:{{ section.settings.utility_text }};">
    <div class="mt-container mt-utility-inner">

      <div class="mt-utility-left">
        {%- if phone != blank -%}
        <a href="tel:{{ phone_tel }}" class="mt-utility-phone">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{{ phone }}</span>
          {%- if section.settings.phone_subtext != blank -%}
            <em>{{ section.settings.phone_subtext }}</em>
          {%- endif -%}
        </a>
        {%- endif -%}
      </div>

      <div class="mt-utility-right">
        {%- comment -%} Contact Us dropdown {%- endcomment -%}
        <div class="mt-utility-item mt-has-dropdown" data-dropdown>
          <button type="button" class="mt-utility-trigger" aria-expanded="false">
            Contact Us
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="mt-dropdown-panel mt-contact-panel">
            <p class="mt-contact-heading">We're Here to Help!</p>
            <p class="mt-contact-sub">Need Help? We have licensed practitioners on staff to answer your questions</p>
            <div class="mt-contact-actions">
              {%- if phone != blank -%}<a href="tel:{{ phone_tel }}">Call</a>{%- endif -%}
              <a href="{{ section.settings.contact_url | default: '/pages/contact-us' }}">Email</a>
              {%- if text_number != blank -%}<a href="sms:{{ text_number | remove: ' ' }}">Text</a>{%- endif -%}
            </div>
            {%- if phone != blank -%}<p>Toll-free: {{ phone }}</p>{%- endif -%}
            {%- if text_number != blank -%}<p>Call or text: {{ text_number }}</p>{%- endif -%}
            {%- if section.settings.hours != blank -%}<p>Hours of Operation:<br>{{ section.settings.hours }}</p>{%- endif -%}
          </div>
        </div>

        {%- comment -%} Account dropdown {%- endcomment -%}
        <div class="mt-utility-item mt-has-dropdown" data-dropdown>
          <button type="button" class="mt-utility-trigger" aria-expanded="false">Account</button>
          <div class="mt-dropdown-panel mt-account-panel">
            <p class="mt-contact-heading">Account</p>
            <p>
              <a href="{{ routes.account_login_url }}">Sign in</a> or
              <a href="{{ routes.account_register_url }}">Register</a>
            </p>
          </div>
        </div>

        {%- comment -%} Currency selector {%- endcomment -%}
        {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
        <div class="mt-utility-item mt-has-dropdown" data-dropdown>
          {%- form 'localization', id: 'HeaderCurrencyForm' -%}
            <button type="button" class="mt-utility-trigger" aria-expanded="false">
              {{ localization.country.currency.iso_code }}
            </button>
            <div class="mt-dropdown-panel mt-currency-panel">
              {%- for country in localization.available_countries -%}
                <button type="submit" name="country_code" value="{{ country.iso_code }}" class="mt-currency-option{% if country.iso_code == localization.country.iso_code %} active{% endif %}">
                  {{ country.name }} ({{ country.currency.iso_code }})
                </button>
              {%- endfor -%}
            </div>
          {%- endform -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== MAIN ROW ===== {%- endcomment -%}
  <div class="mt-main-row" style="background:{{ section.settings.header_bg }};">
    <div class="mt-container mt-main-inner">

      <button type="button" class="mt-mobile-toggle" data-mobile-toggle aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>

      <a href="{{ routes.root_url }}" class="mt-logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            loading="eager">
        {%- else -%}
          <span class="mt-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="mt-search" data-search>
        {%- form 'predictive_search', class: 'mt-search-form' -%}
          <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search' }}" autocomplete="off" value="{{ search.terms }}">
          <button type="submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
        {%- endform -%}
      </div>

      <div class="mt-icons">
        <a href="{{ routes.account_url }}" class="mt-icon-link mt-account-icon" aria-label="Account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <button type="button" class="mt-icon-link mt-search-toggle" data-search-toggle aria-label="Toggle search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>
        <a href="{{ routes.cart_url }}" class="mt-icon-link mt-cart-icon" aria-label="Cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="mt-cart-count" data-cart-count>{{ cart.item_count }}</span>
          <span class="mt-cart-label">Cart {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} ===== MEGA MENU NAV (desktop) ===== {%- endcomment -%}
  {%- if top_menu != blank -%}
  <nav class="mt-nav" style="background:{{ section.settings.nav_bg }};color:{{ section.settings.nav_text }};" aria-label="Primary">
    <div class="mt-container">
      <ul class="mt-nav-list">
        {%- for link in top_menu.links -%}
        <li class="mt-nav-item{% if link.links != blank %} mt-has-mega{% endif %}">
          <a href="{{ link.url }}" class="mt-nav-link">
            {{ link.title }}
            {%- if link.links != blank -%}
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5"/></svg>
            {%- endif -%}
          </a>

          {%- if link.links != blank -%}
          <div class="mt-mega-panel">
            <div class="mt-mega-columns">
              {%- for child in link.links -%}
              <div class="mt-mega-col">
                <a href="{{ child.url }}" class="mt-mega-col-title">{{ child.title }}</a>
                {%- if child.links != blank -%}
                <ul class="mt-mega-sublist">
                  {%- for grandchild in child.links -%}
                  <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- endif -%}
              </div>
              {%- endfor -%}
            </div>
            <a href="{{ link.url }}" class="mt-mega-shop-all">Shop All {{ link.title }} →</a>
          </div>
          {%- endif -%}
        </li>
        {%- endfor -%}
      </ul>
    </div>
  </nav>
  {%- endif -%}

  {%- comment -%} ===== MOBILE MENU DRAWER ===== {%- endcomment -%}
  <div class="mt-mobile-drawer" data-mobile-drawer>
    <div class="mt-mobile-drawer-header">
      <span>Menu</span>
      <button type="button" data-mobile-close aria-label="Close menu">&times;</button>
    </div>
    {%- if top_menu != blank -%}
    <ul class="mt-mobile-list">
      {%- for link in top_menu.links -%}
      <li class="mt-mobile-item">
        <div class="mt-mobile-row">
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
          <button type="button" class="mt-mobile-expand" data-mobile-expand aria-label="Expand {{ link.title }}">+</button>
          {%- endif -%}
        </div>
        {%- if link.links != blank -%}
        <ul class="mt-mobile-sublist">
          {%- for child in link.links -%}
          <li>
            <a href="{{ child.url }}">{{ child.title }}</a>
            {%- if child.links != blank -%}
            <ul class="mt-mobile-subsublist">
              {%- for grandchild in child.links -%}
              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
            {%- endif -%}
          </li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </li>
      {%- endfor -%}
    </ul>
    {%- endif -%}

    {%- if phone != blank -%}
    <div class="mt-mobile-phone">
      <a href="tel:{{ phone_tel }}">{{ phone }}</a>
    </div>
    {%- endif -%}
  </div>
  <div class="mt-mobile-overlay" data-mobile-overlay></div>

</header>

<script src="{{ 'js.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "utility_bg",
      "label": "Utility bar background",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "utility_text",
      "label": "Utility bar text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Main header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Navigation background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "nav_text",
      "label": "Navigation text",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Contact info"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(866) 928-9955"
    },
    {
      "type": "text",
      "id": "phone_subtext",
      "label": "Phone subtext",
      "default": "Talk to a licensed practitioner!"
    },
    {
      "type": "text",
      "id": "text_number",
      "label": "Text (SMS) number",
      "default": "(512) 768-6147"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours of operation",
      "default": "M-F 8:30-5:30 CST"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Currency"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency/country selector",
      "default": true
    }
  ]
}
{% endschema %}
