{%- style -%}
  .header-wrapper {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 0 2rem;
    font-family: {{ section.settings.font_family }};
  }
  
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 15px 0;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Header Top Row */
  .header-top {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap; 
  }

  /* Logo Section */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: {{ section.settings.text_color }};
    flex-shrink: 0;
  }
  .logo-icon-wrapper { margin-right: 12px; height: 37px; }
  .logo-svg { width: 45px; height: 45px; }
  .logo-text-wrapper { display: flex; flex-direction: column; line-height: 0.9; }
  .logo-primary { font-size: 28px; font-weight: 400; letter-spacing: -0.5px; font-family: 'Georgia', serif; font-style: italic; }
  .logo-secondary { font-size: 12px; letter-spacing: 3px; text-transform: uppercase; margin-top: 4px; font-weight: 600; }

  /* Search Bar */
  .header-search {
    flex-grow: 1;
    max-width: 650px;
    min-width: 200px;
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 8px;
    padding: 2px;
    overflow: hidden;
  }
  .header-search input {
    border: none; outline: none; flex-grow: 1; padding: 12px 18px; font-size: 14px; color: #555; background: transparent; width: 100%;
  }
  .header-search button {
    background: {{ section.settings.search_btn_color }};
    border: none; border-radius: 6px; width: 48px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #ffffff; margin-right: 4px; flex-shrink: 0;
  }
  .header-search button svg { width: 18px; height: 18px; fill: currentColor; }

  /* Right Actions (Contact, Account, Cart) */
  .header-actions { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }
  .action-group { display: flex; flex-direction: column; line-height: 1.2; }
  .action-group strong { font-size: 16px; font-weight: 600; }
  .action-group small { font-size: 12px; opacity: 0.8; }
  .action-link-wrapper { display: flex; align-items: center; gap: 5px; text-decoration: none; color: {{ section.settings.text_color }}; cursor: pointer; }
  .contact-popup-wrapper { position: relative; }
  .action-link-wrapper svg { width: 22px; height: 22px; fill: currentColor; }

  /* Cart Icon */
  .header-cart { position: relative; display: flex; align-items: center; text-decoration: none; color: {{ section.settings.text_color }}; }
  .cart-count { background-color: {{ section.settings.cart_badge_color }}; color: #1a1c23; font-weight: 600; border-radius: 50%; padding: 2px 8px; font-size: 14px; margin-left: 5px; min-width: 28px; text-align: center; }

  /* Navigation Menu */
  .header-nav { width: 100%; margin-top: 25px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); overflow-x: auto; white-space: nowrap; display: flex; justify-content: center; position: relative; }
  .nav-list { display: flex; list-style: none; padding: 0; margin: 0; gap: 20px; font-size: 14px; font-weight: 500; }
  .nav-list li { position: relative; display: inline-flex; align-items: center; flex-direction: column; }
  .nav-list li > a { text-decoration: none; color: {{ section.settings.text_color }}; padding: 5px 0; }
  .nav-list li span { margin-left: 4px; font-size: 10px; cursor: pointer; }
  
  /* Dropdown Menus */
  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: {{ section.settings.bg_color }};
    min-width: 200px;
    padding: 10px 0;
    list-style: none;
    border: 1px solid rgba(255,255,255,0.1);
    z-index: 10;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    white-space: normal;
  }
  .nav-dropdown li { display: block; padding: 0; margin: 0; }
  .nav-dropdown li a { display: block; padding: 10px 20px; color: {{ section.settings.text_color }}; }
  
  /* Desktop Hover */
  @media (min-width: 990px) {
    .nav-list li:hover .nav-dropdown { display: block; }
  }

  /* ------------------------------------------------ */
  /* MOBILE RESPONSIVE (MATCHES YOUR SCREENSHOT)      */
  /* ------------------------------------------------ */
  @media screen and (max-width: 989px) {
    /* Lay out Top Bar: Hamburger | Logo | Icons */
    .header-top {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    /* Hide the text part of the phone/contact buttons */
    .action-group strong, .action-group small {
      display: none !important;
    }
    .action-link-wrapper {
      gap: 0;
    }
    /* Make contact/account/cart icons smaller and just icons */
    .header-actions {
      gap: 15px;
    }
    .action-link-wrapper svg, .header-cart svg {
      width: 24px;
      height: 24px;
    }
    /* Remove the down arrows on desktop elements */
    .contact-popup-wrapper .action-link-wrapper svg:last-child,
    .header-actions .action-link-wrapper:not(.contact-popup-wrapper .action-link-wrapper) svg:last-child,
    .header-cart svg:last-child {
      display: none !important;
    }

    /* Logo container logic */
    .header-logo {
      justify-content: center;
      margin-bottom: 0;
      flex: 1; /* Forces logo to take up remaining space in the middle */
    }
    .logo-primary { font-size: 24px; }
    .logo-secondary { font-size: 10px; }

    /* Mobile Hamburger (Left side) */
    .mobile-toggle {
      display: block;
      background: none;
      border: none;
      color: {{ section.settings.text_color }};
      padding: 0;
      font-size: 0; /* Hide the text "Menu" */
      cursor: pointer;
      line-height: 0;
      width: 30px;
    }
    /* Custom 3-bar hamburger icon */
    .mobile-toggle::before {
      content: "☰";
      font-size: 32px;
      display: block;
      line-height: 1;
    }

    /* Search Bar (Next line, full width) */
    .header-search {
      max-width: 100%;
      width: 100%;
      margin-top: 15px;
      order: 10; /* Pushes it below everything else */
      flex-basis: 100%;
    }

    /* Mobile Menu Styling */
    .header-nav { 
      white-space: normal; 
      justify-content: flex-start; 
      padding-bottom: 10px; 
      display: block; 
      margin-top: 0; /* Adjust margins for new layout */
      border-top: none;
      padding-top: 0;
    }
    .nav-list { 
      flex-direction: column; 
      align-items: flex-start; 
      gap: 10px; 
      padding: 10px 0; 
      display: none; 
    }
    .nav-list.active { display: flex; }
    
    .nav-dropdown {
      position: static;
      display: none;
      background: rgba(255,255,255,0.05);
      border: none;
      box-shadow: none;
      padding-left: 15px;
      margin-top: 5px;
    }
    .nav-dropdown.active { display: block; }
  }
  
  @media (min-width: 990px) {
    .mobile-toggle { display: none !important; }
  }
  
  @media screen and (max-width: 480px) {
    .header-wrapper { padding: 0 1rem; }
    .header-actions { gap: 12px; }
    .action-link-wrapper svg, .header-cart svg { width: 22px; height: 22px; }
  }

  /* ========================================= */
  /* CONTACT POPUP CSS                          */
  /* ========================================= */
  .contact-popup-overlay {
    position: absolute !important;
    top: 100% !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: 350px !important;
    background: #ffffff !important;
    z-index: 999999 !important;
    display: none !important;
    padding: 0 !important;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    border-radius: 8px !important;
    box-sizing: border-box !important;
    margin-top: 10px !important;
  }

  .contact-popup-overlay.active {
    display: block !important;
  }

  .contact-popup-card {
    background: #ffffff;
    width: 100%;
    max-width: 400px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    position: relative;
    color: #333;
    text-align: left;
    font-family: inherit;
    margin: 0 auto !important;
  }

  .popup-header { padding: 25px 25px 20px; background: #fff; }
  .popup-header h3 { margin: 0 0 8px 0; font-size: 22px; font-weight: 600; color: #333; }
  .popup-header p { margin: 0; font-size: 15px; color: #555; line-height: 1.4; }

  .popup-icons-bar { background: #343a40; display: flex; justify-content: space-around; padding: 20px 15px; }
  .icon-item { display: flex; flex-direction: column; align-items: center; color: #fff; gap: 8px; }
  .icon-item svg { width: 32px; height: 32px; stroke: #fff; }
  .icon-item span { font-size: 14px; }

  .popup-info-text { padding: 25px; background: #fff; }
  .popup-info-text p { margin: 0 0 12px 0; font-size: 16px; color: #333; }
  .popup-info-text p:last-child { margin-bottom: 0; }

  .popup-footer { background: #343a40; padding: 15px 25px; text-align: center; }
  .popup-footer p { margin: 0; color: #fff; font-size: 15px; }

  .popup-close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    background: none;
    border: none;
    font-size: 28px;
    color: #999;
    cursor: pointer;
    line-height: 1;
    padding: 5px;
    z-index: 10;
  }
  .popup-close-btn:hover { color: #333; }
  
  @media (max-width: 480px) {
    .contact-popup-overlay { width: 300px !important; }
  }
{%- endstyle -%}

