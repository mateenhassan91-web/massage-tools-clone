            <svg viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            <div>
              <strong>Contact Us</strong>
              <small>We're Here to Help!</small>
            </div>
          </div>

          <div id="contact-popup" class="contact-popup-overlay">
            <div class="contact-popup-card">
              <div class="popup-header">
                <h3>Need Help?</h3>
                <p>We have licensed practitioners on staff to answer your questions</p>
              </div>
              <div class="popup-icons-bar">
                <div class="icon-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                  <span>Call</span>
                </div>
                <div class="icon-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  <span>Email</span>
                </div>
                <div class="icon-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span>Text</span>
                </div>
              </div>
              <div class="popup-info-text">
                <p><strong>Toll-free:</strong> (866) 528-3195</p>
                <p><strong>Call or text:</strong> (512) 575-4161</p>
                <p><strong>Hours of Operation:</strong></p>
                <p>M-F 8:30-5:30 CST</p>
              </div>
              <div class="popup-footer">
                <p>24/7 Email and Chat Messages</p>
              </div>
              <button class="popup-close-btn" id="contact-popup-close" type="button" aria-label="Close contact popup">×</button>
            </div>
          </div>
